# rtpengine for the own-pbx Kamailio edge proxy.
# Relays RTP between remote phones and the LAN Asterisk so NAT "just works".
# Generated by install.sh — do not hand-edit.

[rtpengine]
# -1 = no kernel forwarding (not available inside an LXC); userspace relay.
table = -1

# Two logical interfaces on the same NIC: LAN side and public side.
# The "!public-ip" part is the address advertised in SDP to remote phones.
interface = internal/@@LAN_IP@@
interface = external/@@LAN_IP@@!@@PUBLIC_IP@@

listen-ng = 127.0.0.1:2223
listen-cli = 127.0.0.1:2222

# 100 ports = ~25 concurrent calls with headroom. Bump if you grow.
port-min = 20000
port-max = 20099

# Don't forward DTMF/tone events we don't need; keep it simple.
dtmf-log-destination = syslog

log-level = 6
log-facility = local1
