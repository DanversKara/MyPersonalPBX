#!KAMAILIO
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Kamailio edge proxy for own-pbx.
#
# Role: TLS termination + SRTP/NAT traversal for remote phones. Asterisk
# stays the registrar and the authenticator ("APIs are the ext" is
# untouched) — this box only proxies SIP and relays RTP. The PBX itself
# is never exposed.
#
#   Remote phone --TLS 5061--> Kamailio --UDP 5060--> Asterisk (LAN)
#   RTP: phone <-SRTP, UDP 20000-20099-> rtpengine <-plain RTP, LAN-> Asterisk
#
# SRTP (SDES) is terminated at rtpengine: the internet leg is encrypted,
# the LAN leg stays plain RTP. Phones must enable SRTP (Zoiper: account
# settings); without it calls still work but that leg is unencrypted.
#
# Generated by install.sh from this template — do not hand-edit.

####### Global Parameters #########

debug=2
log_stderror=no
log_facility=LOG_LOCAL0

fork=yes
children=4
enable_tls=yes

# Public edge: TLS ONLY (kills ~99% of SIP scanners, they are UDP-based).
# The advertise makes Via/Record-Route carry our public NAME for remote
# phones. It must be the domain on the TLS certificate (not the IP): phones
# send in-call requests (hang-up, hold) to the Record-Route address and
# reject a TLS connection whose certificate doesn't match it - the hang-up
# was lost and the other side stayed connected. The IP changes are handled
# by DNS (Cloudflare) and update-public-ip.sh (alias + rtpengine).
listen=tls:@@LAN_IP@@:5061 advertise @@PUBLIC_HOST@@:5061
# LAN side toward Asterisk.
listen=udp:@@LAN_IP@@:5060

tcp_connection_lifetime=3605
tcp_max_connections=2048

# Our public identity (so is_myself() works for the advertised address).
alias=@@PUBLIC_IP@@
alias=@@PUBLIC_HOST@@

####### Modules Section ########

loadmodule "pv.so"
loadmodule "maxfwd.so"
loadmodule "textops.so"
loadmodule "kex.so"
loadmodule "siputils.so"
loadmodule "xlog.so"
loadmodule "sanity.so"
loadmodule "pike.so"
loadmodule "htable.so"
loadmodule "tm.so"
loadmodule "sl.so"
loadmodule "tmx.so"
loadmodule "rr.so"
loadmodule "nathelper.so"
loadmodule "rtpengine.so"
loadmodule "tls.so"

modparam("tls", "config", "/etc/kamailio/tls.cfg")

modparam("rr", "enable_full_lr", 1)
modparam("nathelper", "received_avp", "$avp(RECEIVED)")
modparam("rtpengine", "rtpengine_sock", "udp:127.0.0.1:2223")
modparam("tm", "failure_reply_mode", 3)
# Flood limit: more than 30 requests in 2 seconds from one IP = flood.
# The IP stays blocked until it has been quiet for 2 minutes.
modparam("pike", "sampling_time_unit", 2)
modparam("pike", "reqs_density_per_unit", 30)
modparam("pike", "remove_latency", 120)
# Phones (Call-ID + user) that signed in successfully in the last 2 hours.
# Their re-registrations that reuse an expired nonce are not failures.
modparam("htable", "htable", "authok=>size=10;autoexpire=7200;")

####### Routing Logic ########

# Main request router.
request_route {
    # Drop malformed / abusive requests early.
    if (!sanity_check("17895", "7")) {
        xlog("L_WARN", "edge: sanity check failed from $si:$sp\n");
        exit;
    }
    # Flood limit (never applied to our own Asterisk). Log only when a flood
    # is first detected (-1), not for every dropped request (-2), so the
    # journal stays readable; fail2ban bans on the first log line.
    if ($si != "@@ASTERISK_IP@@") {
        pike_check_req();
        $var(pike) = $rc;
        if ($var(pike) == -1) {
            xlog("L_WARN", "edge: flood from $si\n");
        }
        if ($var(pike) < 0) {
            exit;
        }
    }
    if (!mf_process_maxfwd_header("10")) {
        sl_send_reply("483", "Too Many Hops");
        exit;
    }

    # Drop known SIP scanners before they cost us anything.
    # Kamailio regexes are POSIX (no (?i)): lower-case the UA, then match.
    if ($ua != $null && $(ua{s.tolower}) =~ "(sipvicious|sipcli|friendly-scanner|sundayddr|vaxsipuseragent|sip-scan|pbx11|siparmyknife)") {
        xlog("L_WARN", "edge: dropping scanner '$ua' from $si\n");
        exit;
    }

    # CANCEL processing.
    if (is_method("CANCEL")) {
        if (t_check_trans())
            t_relay();
        exit;
    }

    # A NEW request from Asterisk to a phone (a call or message to a remote
    # phone). Asterisk pre-loads a Route built from the phone's Path, which
    # points at us and carries received="sip:<phone ip>:<port>;transport=tls"
    # (the phone's open TLS connection). loose_route() does NOT route a
    # pre-loaded Route that points only at ourselves (it returns false), so
    # without this block the request fell through to "send to Asterisk" and
    # looped back - Asterisk answered 401 and the call went to voicemail.
    if ($si == "@@ASTERISK_IP@@" && !has_totag() && is_present_hf("Route")) {
        $var(rcv) = $(hdr(Route){nameaddr.uri}{uri.param,received}{s.unquote});
        remove_hf("Route");
        if ($var(rcv) =~ "^sips?:") {
            $du = $var(rcv);
        }
        # Only reuse the phone's existing connection; a phone behind NAT
        # can't accept a new one (fail fast -> Asterisk goes to voicemail).
        set_forward_no_connect();
        if (is_method("INVITE")) {
            # Toward the phone: offer SRTP (the internet leg is encrypted).
            rtpengine_offer("replace-origin replace-session-connection ICE=remove RTP/SAVP");
            t_on_reply("RTPP_REPLY");
            t_on_failure("TO_PHONE_FAIL");
        }
        # Two Record-Routes (LAN side + public TLS side, rr enable_double_rr)
        # so both ends send in-dialog requests (BYE, re-INVITE) through us.
        record_route();
        if (!t_relay()) {
            sl_reply_error();
        }
        exit;
    }

    # Requests carrying a Route header: in-dialog requests (our Record-Route).
    # loose_route() consumes our hop and sets $du to the next destination.
    if (loose_route()) {
        if (!is_method("ACK")) {
            xlog("L_INFO", "edge: in-call $rm from $si to $ru\n");
        }
        # Safety: if the next hop is ourselves (client preloaded a Route
        # header for the outbound proxy), this is really a new request.
        if (is_myself("$du")) {
            $du = "sip:@@ASTERISK_IP@@:5060";
        }
        # Direction for SRTP: $si==Asterisk means toward the phone (offer
        # SRTP); otherwise toward Asterisk (plain RTP, phone's SRTP is
        # terminated here). $avp(sdes_reply) tells the reply route which
        # transport the response side needs.
        if ($si == "@@ASTERISK_IP@@") {
            $avp(sdes_reply) = 0;  # reply goes to Asterisk -> plain RTP
            set_forward_no_connect();  # phones only via their open connection
        } else {
            $avp(sdes_reply) = 1;  # reply goes to phone -> SRTP
            # Phones only ever talk to Asterisk. Whatever Request-URI or
            # Route a request from outside carries, it goes to Asterisk -
            # never onward to another host (no open relay through the edge).
            $du = "sip:@@ASTERISK_IP@@:5060";
        }
        if (is_method("BYE")) {
            rtpengine_delete();
        } else if (is_method("INVITE|UPDATE")) {
            # In-dialog re-INVITE/UPDATE, or Path-routed initial INVITE
            # from Asterisk toward a phone: relay the media.
            if ($avp(sdes_reply) == 0) {
                rtpengine_offer("replace-origin replace-session-connection ICE=remove RTP/SAVP");
            } else {
                rtpengine_offer("replace-origin replace-session-connection ICE=remove RTP/AVP");
            }
            t_on_reply("RTPP_REPLY");
        }
        if (!t_relay()) {
            sl_reply_error();
        }
        exit;
    }

    # No Route header: a new request from a phone. It must go to Asterisk.
    # Refuse anything that did not arrive over TLS or from the LAN/Asterisk.
    if (!(proto == TLS || $si == "@@ASTERISK_IP@@")) {
        xlog("L_WARN", "edge: refusing non-TLS initial $rm from $si\n");
        sl_send_reply("403", "TLS required");
        exit;
    }

    if (is_method("REGISTER")) {
        # NAT-fix the Contact, then pin a Path back to us (LAN address —
        # Asterisk reaches us over the LAN) so inbound calls find the phone.
        if (nat_uac_test("19"))
            fix_nated_contact();
        append_hf("Path: <sip:@@LAN_IP@@:5060;lr;received=\"sip:$si:$sp;transport=tls\">\r\n");
        t_on_failure("AUTH_FAIL");
        t_on_reply("REG_REPLY");
    } else if (is_method("INVITE")) {
        if (nat_uac_test("19"))
            fix_nated_contact();
        # New INVITE from a phone: accept its SRTP, offer plain RTP to
        # Asterisk (media decrypted at the edge, re-encrypted never leaves
        # the LAN). Reply goes back to the phone -> SRTP.
        $avp(sdes_reply) = 1;
        rtpengine_offer("replace-origin replace-session-connection ICE=remove RTP/AVP");
        t_on_reply("RTPP_REPLY");
        t_on_failure("AUTH_FAIL");
    }

    # Record-Route with our PUBLIC address (via the advertise on the
    # TLS listener) so the phone routes the dialog back through us.
    record_route();

    $du = "sip:@@ASTERISK_IP@@:5060";
    if (!t_relay()) {
        sl_reply_error();
    }
    exit;
}

# Reply handler for INVITEs: rewrite SDP through rtpengine (SRTP toward
# the phone, plain RTP toward Asterisk).
onreply_route[RTPP_REPLY] {
    # A phone's answer carries its private Contact; point it at the phone's
    # real address (its TLS connection) so in-dialog requests from Asterisk
    # (BYE, re-INVITE) reach it.
    if ($si != "@@ASTERISK_IP@@" && nat_uac_test("19")) {
        fix_nated_contact();
    }
    if (t_check_status("2[0-9][0-9]")) {
        # No transport override on the answer: rtpengine answers each side in
        # the protocol that side offered (SRTP phone -> SRTP, plain -> plain).
        # Forcing one here breaks the answer when the offerer chose the other
        # ("SDP mismatch" on the phone).
        rtpengine_answer("replace-origin replace-session-connection ICE=remove");
    }
    exit;
}

# Call to a phone failed (phone gone, declined, no answer): free the media.
failure_route[TO_PHONE_FAIL] {
    rtpengine_delete();
}

# Remember phones that registered successfully (see AUTH_FAIL).
onreply_route[REG_REPLY] {
    if (t_check_status("2[0-9][0-9]")) {
        $sht(authok=>$ci::$fU) = 1;
    }
}

# Failed sign-in detection for fail2ban. Every phone gets one 401/407
# challenge before it sends its password - that's normal. It's a FAILURE
# only when the request already carried credentials and was still refused
# (wrong password or unknown account). A "stale=true" challenge just means
# the phone's nonce expired, so it isn't counted. Runs in the context of
# the phone's request, so $si is the phone's (attacker's) address.
failure_route[AUTH_FAIL] {
    if (t_is_canceled()) {
        exit;
    }
    if (t_check_status("401|403|407") &&
        ($hdr(Authorization) != $null || $hdr(Proxy-Authorization) != $null)) {
        $var(chal) = $T_rpl($hdr(WWW-Authenticate)) + " " + $T_rpl($hdr(Proxy-Authenticate));
        if ($var(chal) =~ "stale=(true|TRUE)") {
            exit;
        }
        # A phone that already signed in on this Call-ID re-registering with
        # its old (expired) nonce gets a fresh challenge and then succeeds:
        # not a failure. Brute forcers never have a successful sign-in.
        if ($rm == "REGISTER" && $sht(authok=>$ci::$fU) == 1) {
            xlog("L_INFO", "edge: re-challenge for REGISTER user '$fU' from $si (signed in before)\n");
            exit;
        }
        xlog("L_WARN", "edge: auth failed for $rm user '$fU' from $si\n");
    }
}
