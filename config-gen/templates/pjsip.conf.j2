; GENERATED by config-gen from the PBX DB — do not hand-edit.
; Re-render with: python3 config-gen/gen.py

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
; Production: bind the LAN IP here. Kamailio is the edge facing the world;
; Asterisk itself is never directly exposed.

[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060

{% for t in trunks %}
; ---- trunk {{ t.name }} ----
[reg-{{ t.name }}]
type=registration
transport=transport-udp
outbound_auth=auth-trunk-{{ t.name }}
server_uri={{ t.registrar }}
client_uri=sip:{{ t.username }}@{{ t.registrar | replace('sip:', '') }}
retry_interval=30

[auth-trunk-{{ t.name }}]
type=auth
auth_type=userpass
username={{ t.username }}
password={{ t.secret }}

[aor-trunk-{{ t.name }}]
type=aor
contact={{ t.registrar }}

[ep-trunk-{{ t.name }}]
type=endpoint
transport=transport-udp
context=trunk-in
disallow=all
allow={{ t.codecs }}
outbound_auth=auth-trunk-{{ t.name }}
aors=aor-trunk-{{ t.name }}
from_user={{ t.from_user or t.username }}
direct_media=no

[identify-trunk-{{ t.name }}]
type=identify
endpoint=ep-trunk-{{ t.name }}
match={{ t.registrar | replace('sip:', '') }}
{% endfor %}

{% for e in extensions %}
; ---- {{ e.exten }} {{ e.display_name }} ----
; The AOR *and* the endpoint MUST both be named after the SIP username:
;  - PJSIP identifies an inbound REGISTER/INVITE's endpoint by matching the
;    From-header username against ENDPOINT names (identify_by=username).
;  - It matches the REGISTER's To-header username against AOR names.
;  - pbx-brain dials callees as PJSIP/<sip_username>.
; Sections of different types may share a name, so this is valid.
[{{ e.sip_username }}]
type=aor
max_contacts=1
remove_existing=yes
; Ping the phone every 60 s (SIP OPTIONS): the dashboard shows Avail/Unavail
; and the response time, and calls skip phones that stopped answering. For
; remote phones the ping goes through the edge over the phone's open TLS
; connection, which also helps keep that connection alive.
qualify_frequency=60
qualify_timeout=5
; Honour the Path header Kamailio adds for remote phones, so inbound calls
; are routed back through the edge. support_path is an AOR option (it is
; rejected on an endpoint). Harmless for LAN phones, which send no Path.
support_path=yes

[auth-{{ e.sip_username }}]
type=auth
auth_type=userpass
username={{ e.sip_username }}
password={{ e.sip_secret }}

[{{ e.sip_username }}]
type=endpoint
identify_by=username,auth_username
transport=transport-udp
context=extensions
message_context=pbx-msg
callerid={{ e.display_name or e.exten }} <{{ e.exten }}>
disallow=all
; No opus: stock Asterisk has no opus<->ulaw translator (codec_opus is a
; separate add-on), so an opus leg bridged to a ulaw phone fails on answer.
allow=ulaw,alaw,g722
auth=auth-{{ e.sip_username }}
aors={{ e.sip_username }}
direct_media=no
rtp_symmetric=yes
rewrite_contact=no
force_rport=yes
{% endfor %}
