<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Camera: only to scan the pairing QR code (asked when you tap Scan). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Notifications for new texts, missed calls and voicemail (Android 13+ asks). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Instant" notifications: a foreground service that stays connected to the PBX. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Built-in phone: microphone, audio routing, and keeping a call going in the background. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Incoming calls: ring over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Settings > Notifications > "Let it run in the background" asks Android directly. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- usesCleartextTraffic: allows http:// to a PBX on the home network.
         The sign-in screen warns when the address isn't https. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyPhone"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing QR codes hold myphone://pair?s=<server>&c=<code>, so the
                 phone's own camera app can open them here too. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="myphone" android:host="pair" />
                <!-- Phone login QR (My Phone > App > Show phone login QR); asks before using it. -->
                <data android:scheme="myphone" android:host="sip" />
            </intent-filter>
        </activity>
        <service
            android:name=".LiveService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
        <service
            android:name=".phone.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- ZXing scanner: follow the phone's rotation (portrait by default). -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />
    </application>
</manifest>
